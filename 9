set serveroutput on;

create table emp_cursor_exp9 (
    empno number primary key,
    ename varchar2(30),
    job varchar2(20),
    sal number
);

insert into emp_cursor_exp9 values (101, 'Arun', 'Manager', 6000);
insert into emp_cursor_exp9 values (102, 'Bala', 'Analyst', 5200);
insert into emp_cursor_exp9 values (103, 'Charan', 'Clerk', 3000);
insert into emp_cursor_exp9 values (104, 'Deepa', 'Manager', 7000);
insert into emp_cursor_exp9 values (105, 'Esha', 'Analyst', 5200);

commit;

-- implicit cursor
declare
    v_rows number;
begin
    update emp_cursor_exp9
    set sal = sal + 500
    where job = 'Clerk';

    if sql%notfound then
        dbms_output.put_line('no rows updated');
    else
        v_rows := sql%rowcount;
        dbms_output.put_line('rows updated: ' || v_rows);
    end if;
end;
/

-- explicit cursor using open, fetch and close
declare
    cursor c1 is
        select * from emp_cursor_exp9;

    v_emp emp_cursor_exp9%rowtype;
begin
    open c1;

    loop
        fetch c1 into v_emp;
        exit when c1%notfound;

        dbms_output.put_line(
            v_emp.empno || ' ' ||
            v_emp.ename || ' ' ||
            v_emp.job || ' ' ||
            v_emp.sal
        );
    end loop;

    close c1;
end;
/

-- cursor for loop
declare
    cursor c1 is
        select ename, sal
        from emp_cursor_exp9;
begin
    for i in c1 loop
        dbms_output.put_line(i.ename || ' ' || i.sal);
    end loop;
end;
/

