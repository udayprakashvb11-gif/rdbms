-- parameterized cursor
declare
    cursor c1(p_job varchar2) is
        select ename
        from emp_cursor_exp9
        where job = p_job;

    v_name emp_cursor_exp9.ename%type;
begin
    dbms_output.put_line('managers');

    open c1('Manager');

    loop
        fetch c1 into v_name;
        exit when c1%notfound;

        dbms_output.put_line(v_name);
    end loop;

    close c1;

    dbms_output.put_line('analysts');

    open c1('Analyst');

    loop
        fetch c1 into v_name;
        exit when c1%notfound;

        dbms_output.put_line(v_name);
    end loop;

    close c1;
end;
/

-- cursor with while loop
declare
    cursor c1 is
        select ename, sal
        from emp_cursor_exp9
        where sal = 5200;

    v_emp c1%rowtype;
begin
    open c1;

    fetch c1 into v_emp;

    while c1%found loop
        dbms_output.put_line(
            v_emp.ename || ' ' || v_emp.sal
        );

        fetch c1 into v_emp;
    end loop;

    close c1;
end;
/

