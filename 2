-- Total number of students in each department
SELECT DeptID, COUNT(*) AS TotalStudents
FROM Student
GROUP BY DeptID;

-- Average marks department-wise
SELECT DeptID, AVG(Marks) AS AverageMarks
FROM Student
GROUP BY DeptID;

-- Maximum and minimum faculty salary
SELECT MAX(Salary) AS MaximumSalary,
       MIN(Salary) AS MinimumSalary
FROM Faculty;

-- GROUP BY and HAVING
SELECT DeptID, COUNT(*) AS TotalStudents
FROM Student
GROUP BY DeptID
HAVING COUNT(*) > 2;

-- Display results using ORDER BY
SELECT *
FROM Student
ORDER BY Marks DESC;

