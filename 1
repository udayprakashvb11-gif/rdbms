-- Update student marks
UPDATE Student
SET Marks = Marks + 5
WHERE Marks < 70;

-- Add a new column
ALTER TABLE Student ADD Email VARCHAR2(60);

-- Retrieve records using WHERE
SELECT * FROM Student WHERE Marks > 80;

-- IN operator
SELECT * FROM Student WHERE DeptID IN (1, 2);

-- BETWEEN operator
SELECT * FROM Student WHERE Marks BETWEEN 60 AND 90;

-- LIKE operator
SELECT * FROM Student WHERE StudentName LIKE 'A%';

-- Drop a column
ALTER TABLE Student DROP COLUMN Email;

-- Rename a table and rename it back
RENAME Course TO CourseDetails;
RENAME CourseDetails TO Course;

-- Drop and recreate Enrollment
DROP TABLE Enrollment;

CREATE TABLE Enrollment (
    StudentID NUMBER,
    CourseID NUMBER,
    EnrollDate DATE DEFAULT SYSDATE,
    PRIMARY KEY (StudentID, CourseID),
    FOREIGN KEY (StudentID) REFERENCES Student(StudentID),
    FOREIGN KEY (CourseID) REFERENCES Course(CourseID)
);

-- Delete records conditionally
DELETE FROM Student WHERE Marks < 40;

