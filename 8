SET SERVEROUTPUT ON;

-- CREATE TABLE
CREATE TABLE STUDENT_PL (
    ID NUMBER PRIMARY KEY,
    NAME VARCHAR2(30),
    GENDER VARCHAR2(10),
    AGE NUMBER,
    EMAIL VARCHAR2(50),
    P_DEPT VARCHAR2(30),
    MARKS NUMBER
);

