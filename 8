-- PROCEDURE TO INSERT STUDENT
CREATE OR REPLACE PROCEDURE INSERT_STUDENT(
    PID NUMBER,
    PNAME VARCHAR2,
    PGENDER VARCHAR2,
    PAGE NUMBER,
    PEMAIL VARCHAR2,
    PDEPT VARCHAR2,
    PMARKS NUMBER
) IS
BEGIN
    INSERT INTO STUDENT_PL
    VALUES (PID, PNAME, PGENDER, PAGE, PEMAIL, PDEPT, PMARKS);

    DBMS_OUTPUT.PUT_LINE('Student inserted successfully');
END;
/

EXEC INSERT_STUDENT(124, 'KAVI', 'FEMALE', 20,
                    'kavi@gmail.com', 'CSE', 88);

COMMIT;

-- FUNCTION TO CALCULATE GRADE
CREATE OR REPLACE FUNCTION CALCULATES_GRADE(
    PMARKS NUMBER
) RETURN VARCHAR2 IS
BEGIN
    IF PMARKS >= 90 THEN
        RETURN 'A';
    ELSIF PMARKS >= 80 THEN
        RETURN 'B';
    ELSIF PMARKS >= 70 THEN
        RETURN 'C';
    ELSE
        RETURN 'D';
    END IF;
END;
/

-- DISPLAY STUDENT GRADE
SELECT NAME, MARKS,
       CALCULATES_GRADE(MARKS) AS GRADE
FROM STUDENT_PL;

-- PROCEDURE TO UPDATE MARKS
CREATE OR REPLACE PROCEDURE UPDATE_MARKS(
    PID NUMBER,
    PMARKS NUMBER
) IS
BEGIN
    UPDATE STUDENT_PL
    SET MARKS = PMARKS
    WHERE ID = PID;

    DBMS_OUTPUT.PUT_LINE('Marks updated successfully');
END;
/

EXEC UPDATE_MARKS(121, 95);

COMMIT;

