set serveroutput on;

-- salary check trigger
create table emp_trigger_exp11 (
    emp_id number primary key,
    emp_name varchar2(30),
    salary number
);

insert into emp_trigger_exp11 values (101, 'Ram', 15000);
insert into emp_trigger_exp11 values (102, 'Hari', 8000);

select * from emp_trigger_exp11;

create or replace trigger trg_salary_check_exp11
before insert on emp_trigger_exp11
for each row
begin
    if :new.salary < 10000 then
        raise_application_error(
            -20001,
            'salary must be greater than or equal to 10000'
        );
    end if;
end;
/

insert into emp_trigger_exp11 values (104, 'Raja', 12000);

