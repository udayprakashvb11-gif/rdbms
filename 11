create or replace trigger trg_overdraft_exp11
before update of balance on bank_acc_exp11
for each row
begin
    if :new.balance < 0 then
        insert into loan_exp11
        values (501, :new.acc_no, abs(:new.balance));

        insert into borrower_exp11
        values (1, :old.customer_name, 501);

        :new.balance := 0;
    end if;
end;
