-- calculate total marks trigger
create table student_trigger_exp11 (
    reg_no number primary key,
    name varchar2(30),
    mark1 number,
    mark2 number,
    mark3 number,
    total number
);

create or replace trigger trg_total_marks_exp11
before insert on student_trigger_exp11
for each row
begin
    :new.total := :new.mark1 + :new.mark2 + :new.mark3;
end;
/

